# Azure AI Foundry
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com"
AZURE_OPENAI_API_KEY="your-key-here"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# Optional model deployment names — defaults match the Azure portal common names
AZURE_DEPLOYMENT_PRIMARY="gpt-5-mini"
AZURE_DEPLOYMENT_PRO="gpt-5"
AZURE_DEPLOYMENT_REASONING="o4-mini"
AZURE_DEPLOYMENT_EMBEDDING="text-embedding-3-large"
AZURE_DEPLOYMENT_IMAGE="gpt-image-1"

# Site
NEXT_PUBLIC_APP_NAME="Notecount"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
