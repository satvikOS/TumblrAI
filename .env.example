# --- Azure AI Foundry ---
# Required
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE.openai.azure.com"
AZURE_OPENAI_API_KEY="your-key-here"
# The deployment name you created in Azure (NOT the model name).
# A single gpt-5-nano deployment is a valid full setup.
AZURE_DEPLOYMENT_PRIMARY="gpt-5-nano"

# Optional
AZURE_OPENAI_API_VERSION="2024-12-01-preview"
# When unset, "pro" and "reasoning" route to the primary deployment.
# AZURE_DEPLOYMENT_PRO="gpt-5"
# AZURE_DEPLOYMENT_REASONING="o4-mini"

# Image generation (gpt-image-1 / DALL-E). Different model class — chat
# models cannot generate images. Leave unset to disable image generation.
# AZURE_DEPLOYMENT_IMAGE="gpt-image-1"

# Embeddings (text-embedding-3-large). Different model class.
# Leave unset to disable embedding-backed semantic search.
# AZURE_DEPLOYMENT_EMBEDDING="text-embedding-3-large"

# --- Site ---
NEXT_PUBLIC_APP_NAME="Notecount"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
